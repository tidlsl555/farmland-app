# Netlify/Vercel 빌드 환경변수 (브라우저 공개용 키만 사용)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# 아래 값은 Supabase Edge Function secret 전용입니다.
# 웹 호스팅 빌드 환경변수에 추가하지 마세요.
VWORLD_API_KEY=YOUR_VWORLD_SERVER_API_KEY
VWORLD_DOMAIN=https://your-production-domain.example
ALLOWED_ORIGINS=https://your-production-domain.example
